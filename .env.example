# Port the HTTP server binds to.
PORT=3000

# Shared secret every webhook caller must send as the x-hooky-secret header.
HOOKY_SECRET=change-me

# Telegram: token from BotFather, chat id of the target chat or group.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy: optional, like the Teams url below. A topic is a destination, so it
# normally sits on the target (per hook, in the UI). Set NTFY_TOPIC only when
# every hook that targets ntfy publishes to the same topic. NTFY_SERVER is for a
# self-hosted instance, NTFY_TOKEN for a protected topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Teams: optional. The webhook url is one Teams channel, so it normally lives on
# the target (per hook, in the UI). Set it here only when every hook that targets
# teams posts to the same channel. The sig in the query string authorizes the
# call, so treat the whole url as a secret either way.
TEAMS_WEBHOOK=

# Outgoing webhook: optional, and normally empty. A url, a method, headers and a
# body are what differs per hook, so they belong on the target. Set this only
# when every hook that targets webhook calls the same endpoint.
WEBHOOK_URL=

# Base of a reply link, for a question a hook call asks. The agent that asks may
# reach this instance on 127.0.0.1 while the link has to be openable on a phone,
# so set this to the address a human uses. Empty derives it from the request.
HOOKY_PUBLIC_URL=
